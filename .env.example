# Runtime environment variables for Lixto — AI agent for Brazilian public procurement
# Web app and CLI both read LIXTO_DATABASE_URL. On Dokploy it points at the
# shared-infra Postgres.

LIXTO_DATABASE_URL=postgresql://lixto:lixto@localhost:5433/lixto

# Internal batch endpoints (lixto match run / lixto recommend run trigger
# these on the web app — tickets 90/91). Same LIXTO_INTERNAL_TOKEN value must
# be set on both the web app and the CLI. Prod value for the URL is the
# Dokploy service name on dokploy-network: http://lixto-web-evs842:3000
LIXTO_WEB_INTERNAL_URL=http://localhost:3000
LIXTO_INTERNAL_TOKEN=

# LLM Configuration — defaults to OpenAI API (https://api.openai.com/v1)
# To use an OpenAI-compatible provider, set LIXTO_LLM_BASE_URL
# LIXTO_LLM_BASE_URL=

# API key for LLM provider (required for OpenAI; falls back to OPENAI_API_KEY)
LIXTO_LLM_API_KEY=

# Model tiers (defaults shown; adjust per provider)
# LIXTO_LLM_MODEL_CHEAP=gpt-5-mini
# LIXTO_LLM_MODEL_DOC=gpt-5.1
# LIXTO_LLM_MODEL_STRONG=gpt-5.1
# LIXTO_LLM_MODEL_FALLBACK=

# Embedding model (must produce 1536 dimensions to match vector(1536) in the database)
# LIXTO_LLM_MODEL_EMBED=text-embedding-3-small

# Chat agent model
# LIXTO_CHAT_MODEL=gpt-5-mini

# PNCP API request throttle (seconds between requests; default 0.25 = 4 req/s)
# LIXTO_MIN_REQUEST_INTERVAL=0.25

# Reference data
LIXTO_IBGE_CNAE_URL=https://servicodados.ibge.gov.br/api/v2/cnae/subclasses

# File uploads directory (dev: ./uploads, prod: /app/uploads)
UPLOADS_DIR=/app/uploads
