# Runtime environment variables for plataforma-licitante
# Web app and CLI both read PLIC_DATABASE_URL. On Dokploy it points at the
# shared-infra Postgres. OPENAI_API_KEY is only needed for `plic agents run`
# and is not deployed on the VPS.

PLIC_DATABASE_URL=postgresql://plic:plic@localhost:5433/plic
PLIC_MIN_REQUEST_INTERVAL=0.25
