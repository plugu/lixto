# Runtime environment variables for Lixto — AI agent for Brazilian public procurement
# Web app and CLI both read LIXTO_DATABASE_URL. On Dokploy it points at the
# shared-infra Postgres.

LIXTO_DATABASE_URL=postgresql://lixto:lixto@localhost:5433/lixto

# Internal batch endpoints (lixto match run / lixto recommend run trigger
# these on the web app). Same LIXTO_INTERNAL_TOKEN value must be set on both
# the web app and the CLI. Prod value for the URL is the Dokploy service name
# on dokploy-network: http://lixto-web-evs842:3000
LIXTO_WEB_INTERNAL_URL=http://localhost:3000
LIXTO_INTERNAL_TOKEN=

# LLM Configuration — primary provider (Gemini via OpenAI-compatible endpoint)
LIXTO_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Gemini API key
LIXTO_LLM_API_KEY=

# Model tiers for primary provider
LIXTO_LLM_MODEL_CHEAP=gemini-3.5-flash-lite
LIXTO_LLM_MODEL_DOC=gemini-3.7-flash
LIXTO_LLM_MODEL_STRONG=gemini-3.7-flash
LIXTO_LLM_MODEL_EMBED=gemini-embedding-001

# Chat and recommendation models
LIXTO_CHAT_MODEL=gemini-3.7-flash
LIXTO_RECOMMEND_MODEL=gemini-3.7-flash

# Fallback provider (OpenAI, used when primary provider errors)
LIXTO_LLM_FALLBACK_BASE_URL=https://api.openai.com/v1
# OpenAI API key
LIXTO_LLM_FALLBACK_API_KEY=
LIXTO_LLM_FALLBACK_MODEL_CHEAP=gpt-5-mini
LIXTO_LLM_FALLBACK_MODEL_DOC=gpt-5-mini
LIXTO_LLM_FALLBACK_MODEL_STRONG=gpt-5.1

# Cost fence — restricts details fetch and enrichment to a configured slice
# (top-3 portals, modalities 6/8, open/upcoming only). Ingestion stays unfenced.
LIXTO_FENCE_PORTALS=Compras.gov.br,ECustomize Consultoria em Software S.A,IPM Sistemas
LIXTO_FENCE_MODALITIES=6,8
LIXTO_FENCE_OPEN_ONLY=1

# Daily cap on enrichment rows (stops after reaching this many in a day)
LIXTO_ENRICH_DAILY_CAP=1500

# PNCP API request throttle (seconds between requests; default 0.5 = 2 req/s)
LIXTO_MIN_REQUEST_INTERVAL=0.5

# Reference data
LIXTO_IBGE_CNAE_URL=https://concla.ibge.gov.br/export/tabelas/ascii/subclasses.txt

# File uploads directory (dev: ./uploads, prod: /app/uploads)
UPLOADS_DIR=/app/uploads

# Transactional email configuration (cycle 22)
# in-network MTA (Dokploy service name)
LIXTO_SMTP_HOST=lixto-mail
LIXTO_SMTP_PORT=25
# Quoted: the angle brackets are shell redirections under `set -a; . .env`.
LIXTO_EMAIL_FROM="Lixto <nao-responda@lixto.com.br>"
LIXTO_EMAIL_REPLY_TO=
LIXTO_APP_URL=https://lixto.com.br

# Signing key for the digest unsubscribe link (HMAC over the recipient's
# address). Dedicated on purpose — do NOT reuse LIXTO_INTERNAL_TOKEN. Unset or
# empty means every unsubscribe token is rejected and the digest refuses to
# build its footer link, instead of signing with an empty (forgeable) key.
# Generate with: openssl rand -base64 48
LIXTO_UNSUBSCRIBE_SECRET=
