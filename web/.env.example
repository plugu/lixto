# Web app configuration (copy to .env.local for local development).

# Postgres connection string for the `lixto` database (ADR 001 §D1).
# Local dev default (docker-compose service `db`):
LIXTO_DATABASE_URL=postgresql://lixto:lixto@localhost:5433/lixto

# Shared secret for the internal batch routes (POST /api/internal/**), sent by
# the CLI as the `x-lixto-internal-token` header. Unset (or empty) means the
# internal routes answer 401 to everyone.
LIXTO_INTERNAL_TOKEN=

# LLM Configuration — primary provider (Gemini via OpenAI-compatible endpoint)
LIXTO_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Gemini API key
LIXTO_LLM_API_KEY=

# Model for embeddings (must produce 1536 dimensions to match vector(1536) in the database)
LIXTO_LLM_MODEL_EMBED=gemini-embedding-001

# Chat model for the agent
LIXTO_CHAT_MODEL=gemini-3.7-flash

# Recommendation model (GO/NO-GO verdicts, Tier-3)
LIXTO_RECOMMEND_MODEL=gemini-3.7-flash

# Directory where company habilitação documents are written
# (docs/TENANT.md). Defaults to ./uploads locally; in the container the
# Dockerfile sets it to /app/uploads, backed by a named volume.
UPLOADS_DIR=./uploads

# Transactional email configuration (cycle 22)
LIXTO_SMTP_HOST=lixto-mail
LIXTO_SMTP_PORT=25
# Quoted: the angle brackets are shell redirections under `set -a; . .env`.
LIXTO_EMAIL_FROM="Lixto <nao-responda@lixto.com.br>"
LIXTO_EMAIL_REPLY_TO=
LIXTO_APP_URL=https://lixto.com.br
# DSN maildir written by lixto-mail; the web container must mount the same
# volume at this path or `lixto email bounces` reports zeros (ticket 120).
LIXTO_BOUNCE_MAILDIR=/var/db/mail/bounces

# Signing key for the digest unsubscribe link (HMAC over the recipient's
# address), verified by GET/POST /email/unsubscribe. Dedicated on purpose — do
# NOT reuse LIXTO_INTERNAL_TOKEN. Unset or empty means every unsubscribe token
# is rejected and the digest refuses to build its footer link, instead of
# signing with an empty (forgeable) key. Must match the CLI's value.
# Generate with: openssl rand -base64 48
LIXTO_UNSUBSCRIBE_SECRET=
