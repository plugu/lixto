# Web app configuration (copy to .env.local for local development).

# Postgres connection string for the `lixto` database (ADR 001 §D1).
# Local dev default (docker-compose service `db`):
LIXTO_DATABASE_URL=postgresql://lixto:lixto@localhost:5433/lixto

# LLM Configuration — defaults to OpenAI API (https://api.openai.com/v1)
# API key for LLM provider (required for OpenAI; falls back to OPENAI_API_KEY)
LIXTO_LLM_API_KEY=

# To use an OpenAI-compatible provider, set this base URL
# LIXTO_LLM_BASE_URL=

# Chat model for the agent (default: gpt-5-mini)
# LIXTO_CHAT_MODEL=gpt-5-mini

# Embedding model (must produce 1536 dimensions to match vector(1536) in the database; default: text-embedding-3-small)
# LIXTO_LLM_MODEL_EMBED=text-embedding-3-small

# Directory where company habilitação documents are written
# (docs/TENANT.md). Defaults to ./uploads locally; in the container the
# Dockerfile sets it to /app/uploads, backed by a named volume.
UPLOADS_DIR=./uploads
